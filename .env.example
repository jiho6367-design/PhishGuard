# Optional file: the primary app starts without .env or any API key.
PHISH_BACKEND=rules
PHISH_THRESHOLD=0.20

# Optional local API token. This is unrelated to an OpenAI API key.
PHISH_API_TOKEN=

# Optional absolute folder for settings.json and phishguard.db.
# Defaults to the project's data folder regardless of the terminal's directory.
PHISH_DATA_DIR=

# Optional compatibility Streamlit screen (loopback URLs only).
PHISH_API_URL=http://127.0.0.1:8080

# Existing Gmail OAuth credentials only; Gmail is never queried on startup.
# Install requirements-gmail.txt before explicitly using Gmail tools.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional cached classifier. Must have explicit PHISHING and NORMAL labels.
# PHISH_BACKEND=hf
# PHISH_HF_MODEL=C:/path/to/previously-cached-phishing-model
# No OpenAI key is used by this application.
